# Copia este fichero como .env y rellena los valores
# NUNCA subas .env a GitHub

# Base de datos (Railway lo inyecta automáticamente en producción)
DATABASE_URL=sqlite:///./cartera.db

# Orígenes permitidos para CORS (en producción: tu dominio de Vercel)
# Separados por coma si hay más de uno
# En local puedes dejarlo en * o poner http://localhost:3000
ALLOWED_ORIGINS=*

# API Keys
FMP_API_KEY=tu_api_key_de_fmp_aqui
ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui
